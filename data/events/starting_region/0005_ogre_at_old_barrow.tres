[gd_resource type="Resource" script_class="EventDefinition" load_steps=23 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/event_definition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_stage_definition.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_option_definition.gd" id="3_option"]
[ext_resource type="Resource" path="res://data/mobs/0020_experienced_ogre.tres" id="4_ogre"]
[ext_resource type="Resource" path="res://data/loot/ironward_vanguard_ilvl20_drop_table.tres" id="5_ilvl10_source"]

[sub_resource type="Resource" id="Option_DEX"]
script = ExtResource("3_option")
id = "strike_immediately"
driver_attribute = "dexterity"
next_stage_id = "dex_attack"
personality_axis_id = "courage"
personality_delta = 5

[sub_resource type="Resource" id="Option_STR"]
script = ExtResource("3_option")
id = "bring_down_stones"
driver_attribute = "strength"
next_stage_id = "str_preparation"

[sub_resource type="Resource" id="Option_CON"]
script = ExtResource("3_option")
id = "wear_the_ogre_down"
driver_attribute = "constitution"
next_stage_id = "con_preparation"
personality_axis_id = "courage"
personality_delta = -5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "На равнине герой замечает старый разграбленный курган. Возле него обосновался опытный огр: вокруг валяются останки животных, обломки повозок и вещи погибших путников. Герой понимает, что противник опасен, но местность позволяет попытаться ранить его до настоящей схватки."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_DEX"), SubResource("Option_STR"), SubResource("Option_CON")])

[sub_resource type="Resource" id="Stage_dex_attack"]
script = ExtResource("2_stage")
id = "dex_attack"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "Герой замечает короткий момент, когда огр отворачивается, и не тратит время на дальнейшую подготовку. Он стремительно сокращает дистанцию и успевает серьёзно ранить противника прежде, чем тот разворачивается для боя."
next_stage_id = "dex_combat"

[sub_resource type="Resource" id="Stage_dex_combat"]
script = ExtResource("2_stage")
id = "dex_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_ogre")
combat_victory_stage_id = "reward_end"
combat_start_hp_ratio = 0.75

[sub_resource type="Resource" id="Stage_str_preparation"]
script = ExtResource("2_stage")
id = "str_preparation"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой два тика расшатывает тяжёлые камни на краю кургана, а затем шумом подманивает огра под старую кладку. Обвал ранит чудовище, но герой не спешит выходить на открытый бой."
next_stage_id = "str_second_check"

[sub_resource type="Resource" id="Stage_str_second_check"]
script = ExtResource("2_stage")
id = "str_second_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "any_trait_present"
checked_trait_ids = PackedStringArray("devious", "conservative")
trait_present_stage_id = "str_extra_preparation"
trait_absent_stage_id = "str_combat"

[sub_resource type="Resource" id="Stage_str_extra_preparation"]
script = ExtResource("2_stage")
id = "str_extra_preparation"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой решает, что честная схватка с таким противником ему ничего не должна. Ещё два тика он держится вне досягаемости, заманивает огра между обломками и подготовленной западней и наносит ему ещё одну тяжёлую рану перед боем."
next_stage_id = "str_extra_combat"

[sub_resource type="Resource" id="Stage_str_combat"]
script = ExtResource("2_stage")
id = "str_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_ogre")
combat_victory_stage_id = "reward_end"
combat_start_hp_ratio = 0.8

[sub_resource type="Resource" id="Stage_str_extra_combat"]
script = ExtResource("2_stage")
id = "str_extra_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_ogre")
combat_victory_stage_id = "reward_end"
combat_start_hp_ratio = 0.65

[sub_resource type="Resource" id="Stage_con_preparation"]
script = ExtResource("2_stage")
id = "con_preparation"
stage_type = 0
decision_role = 0
duration_ticks = 3
scene_text = "Герой не выходит против огра сразу. Три тика он держится на границе досягаемости, провоцирует тяжёлого противника на короткие погони и заставляет его снова и снова продираться через неудобную местность. Огр устаёт и получает несколько ран, прежде чем герой готовится принять бой."
next_stage_id = "con_second_check"

[sub_resource type="Resource" id="Stage_con_second_check"]
script = ExtResource("2_stage")
id = "con_second_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "any_trait_present"
checked_trait_ids = PackedStringArray("devious", "conservative")
trait_present_stage_id = "con_extra_preparation"
trait_absent_stage_id = "con_combat"

[sub_resource type="Resource" id="Stage_con_extra_preparation"]
script = ExtResource("2_stage")
id = "con_extra_preparation"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой не считает первую подготовку достаточной. Ещё два тика он не даёт огру навязать прямую схватку, выводит его к заранее выбранной западне среди обломков кургана и добивается ещё одной раны, прежде чем наконец вступить в бой."
next_stage_id = "con_extra_combat"

[sub_resource type="Resource" id="Stage_con_combat"]
script = ExtResource("2_stage")
id = "con_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_ogre")
combat_victory_stage_id = "reward_end"
combat_start_hp_ratio = 0.85

[sub_resource type="Resource" id="Stage_con_extra_combat"]
script = ExtResource("2_stage")
id = "con_extra_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_ogre")
combat_victory_stage_id = "reward_end"
combat_start_hp_ratio = 0.7

[sub_resource type="Resource" id="Stage_reward_end"]
script = ExtResource("2_stage")
id = "reward_end"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "У старого кургана герой столкнулся с опытным огром. Подготовив схватку по-своему и победив сильного противника, он осмотрел вещи прежних жертв и нашёл среди них добротную экипировку десятого уровня."
outcome_id = "experienced_ogre_defeated"
equipment_reward_source = ExtResource("5_ilvl10_source")
equipment_rarity_override = 1

[resource]
script = ExtResource("1_event")
id = "ogre_at_old_barrow"
display_name = "Огр у старого кургана"
region_id = "starting_region"
placement_distance_hex_min = 5
placement_distance_hex_max = 6
placement_allowed_terrain_ids = PackedStringArray("plains")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_dex_attack"), SubResource("Stage_dex_combat"), SubResource("Stage_str_preparation"), SubResource("Stage_str_second_check"), SubResource("Stage_str_extra_preparation"), SubResource("Stage_str_combat"), SubResource("Stage_str_extra_combat"), SubResource("Stage_con_preparation"), SubResource("Stage_con_second_check"), SubResource("Stage_con_extra_preparation"), SubResource("Stage_con_combat"), SubResource("Stage_con_extra_combat"), SubResource("Stage_reward_end")])
