[gd_resource type="Resource" script_class="EventDefinition" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/event_definition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_stage_definition.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_option_definition.gd" id="3_option"]

[sub_resource type="Resource" id="Option_DEX"]
script = ExtResource("3_option")
id = "save_only_safe_crates"
driver_attribute = "dexterity"
next_stage_id = "dex_cover"
personality_axis_id = "curiosity"
personality_delta = -5

[sub_resource type="Resource" id="Option_WIS"]
script = ExtResource("3_option")
id = "save_supplies_for_people"
driver_attribute = "wisdom"
next_stage_id = "wis_share"
personality_axis_id = "greed"
personality_delta = 5

[sub_resource type="Resource" id="Option_CON"]
script = ExtResource("3_option")
id = "salvage_everything_for_share"
driver_attribute = "constitution"
next_stage_id = "con_salvage"
personality_axis_id = "greed"
personality_delta = -5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
duration_ticks = 1
scene_text = "На лесной дороге героя застаёт резкий ливень. Небольшой торговый обоз успел свернуть с основного тракта, но одна телега увязла возле склона, и вода уже подбирается к тюкам с тканью, мешкам с мукой и коробам с инструментами. Люди пытаются спасти всё сразу и только мешают друг другу."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_DEX"), SubResource("Option_WIS"), SubResource("Option_CON")])

[sub_resource type="Resource" id="Stage_dex_cover"]
script = ExtResource("2_stage")
id = "dex_cover"
stage_type = 0
duration_ticks = 2
scene_text = "Герой быстро выбирает только те ящики, к которым можно добраться без риска скатиться вместе с телегой по размокшему склону. Два тика он переносит сухие и дорогие вещи под навес, а когда земля начинает ползти, прекращает работу, не пытаясь вытащить последние тюки любой ценой."
next_stage_id = "dex_end"

[sub_resource type="Resource" id="Stage_wis_share"]
script = ExtResource("2_stage")
id = "wis_share"
stage_type = 0
duration_ticks = 3
scene_text = "Герой понимает, что часть промокшей муки и простых одеял уже не удастся выгодно продать, но ими всё ещё можно помочь людям. Три тика он вместе с обозниками сортирует груз и отдаёт пригодные припасы ближайшим углежогам, оставляя торговцу дорогие сухие товары."
next_stage_id = "wis_end"

[sub_resource type="Resource" id="Stage_con_salvage"]
script = ExtResource("2_stage")
id = "con_salvage"
stage_type = 0
duration_ticks = 4
scene_text = "Герой четыре тика таскает мокрые тюки и вытаскивает ящики даже из самой вязкой грязи. Он спасает почти всё, что ещё можно продать, но заранее договаривается, что за такую работу получит заметную долю от сохранённой стоимости."
next_stage_id = "con_end"

[sub_resource type="Resource" id="Stage_dex_end"]
script = ExtResource("2_stage")
id = "dex_end"
stage_type = 4
duration_ticks = 1
diary_text = "Во время ливня герой помог торговому обозу спасти только те ящики, которые можно было вынести без лишнего риска. За сохранённый дорогой товар ему заплатили пятьдесят пять золотых."
outcome_id = "caravan_goods_saved_cautiously"
gold_reward = 55

[sub_resource type="Resource" id="Stage_wis_end"]
script = ExtResource("2_stage")
id = "wis_end"
stage_type = 4
duration_ticks = 1
diary_text = "Под ливнем герой помог обозникам спасти груз и отдал часть уже непригодных для продажи припасов местным углежогам. Он взял лишь двадцать золотых за потраченное время."
outcome_id = "caravan_supplies_shared"
gold_reward = 20

[sub_resource type="Resource" id="Stage_con_end"]
script = ExtResource("2_stage")
id = "con_end"
stage_type = 4
duration_ticks = 1
diary_text = "Герой долго вытаскивал торговый груз из грязи и спас почти всё, что ещё можно было продать. За большой сохранённый товарный остаток он потребовал и получил девяносто пять золотых."
outcome_id = "caravan_goods_salvaged_for_share"
gold_reward = 95

[resource]
script = ExtResource("1_event")
id = "rain_over_caravan"
display_name = "Ливень над обозом"
region_id = "starting_region"
placement_distance_hex_min = 3
placement_distance_hex_max = 5
placement_allowed_terrain_ids = PackedStringArray("forest")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_dex_cover"), SubResource("Stage_wis_share"), SubResource("Stage_con_salvage"), SubResource("Stage_dex_end"), SubResource("Stage_wis_end"), SubResource("Stage_con_end")])
