[gd_resource type="Resource" script_class="EventDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/event_definition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_stage_definition.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_option_definition.gd" id="3_option"]
[ext_resource type="Resource" path="res://data/mobs/0009_bandit_veteran.tres" id="4_bandit"]

[sub_resource type="Resource" id="Option_STR"]
script = ExtResource("3_option")
id = "demand_surrender"
driver_attribute = "strength"
next_stage_id = "str_confront"
personality_axis_id = "courage"
personality_delta = 5

[sub_resource type="Resource" id="Option_DEX"]
script = ExtResource("3_option")
id = "strip_his_weapon"
driver_attribute = "dexterity"
next_stage_id = "dex_disarm"
personality_axis_id = "curiosity"
personality_delta = 5

[sub_resource type="Resource" id="Option_WIS"]
script = ExtResource("3_option")
id = "catch_him_in_lies"
driver_attribute = "wisdom"
next_stage_id = "wis_question"
personality_axis_id = "morality"
personality_delta = 5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
duration_ticks = 1
scene_text = "В холмах герой встречает раненого мужчину в дорогой, но сильно запылённой наёмничьей броне. Тот представляется ограбленным путником и просит показать дорогу к городу. На ремне под плащом герой замечает знак банды, за одного из ветеранов которой городские власти назначили награду."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_STR"), SubResource("Option_DEX"), SubResource("Option_WIS")])

[sub_resource type="Resource" id="Stage_str_confront"]
script = ExtResource("2_stage")
id = "str_confront"
stage_type = 0
duration_ticks = 1
scene_text = "Герой не играет в разговоры. Он встаёт поперёк тропы, указывает на знак банды и требует, чтобы наёмник бросил оружие и сдался. Ветеран понимает, что его узнали, и медленно кладёт руку на рукоять."
next_stage_id = "str_devious_check"

[sub_resource type="Resource" id="Stage_dex_disarm"]
script = ExtResource("2_stage")
id = "dex_disarm"
stage_type = 0
duration_ticks = 2
scene_text = "Герой два тика поддерживает вид дружелюбного разговора, одновременно выбирая момент. Когда наёмник отвлекается, герой режет ремень ножен и рывком отбрасывает оружие в сторону. В короткой борьбе ветеран получает ещё одну рану, но остаётся опасен."
next_stage_id = "dex_devious_check"

[sub_resource type="Resource" id="Stage_wis_question"]
script = ExtResource("2_stage")
id = "wis_question"
stage_type = 0
duration_ticks = 2
scene_text = "Два тика герой задаёт будто бы случайные вопросы о месте нападения, дороге и спутниках. Рассказ наёмника распадается на противоречия. Когда герой спокойно перечисляет их одно за другим, беглец понимает, что легенда провалилась, и начинает искать возможность прорваться силой."
next_stage_id = "wis_devious_check"

[sub_resource type="Resource" id="Stage_str_devious_check"]
script = ExtResource("2_stage")
id = "str_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "devious_confession"
trait_absent_stage_id = "str_combat"

[sub_resource type="Resource" id="Stage_dex_devious_check"]
script = ExtResource("2_stage")
id = "dex_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "devious_confession"
trait_absent_stage_id = "dex_combat"

[sub_resource type="Resource" id="Stage_wis_devious_check"]
script = ExtResource("2_stage")
id = "wis_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "devious_confession"
trait_absent_stage_id = "wis_combat"

[sub_resource type="Resource" id="Stage_devious_confession"]
script = ExtResource("2_stage")
id = "devious_confession"
stage_type = 0
duration_ticks = 2
scene_text = "Вместо того чтобы доводить дело до драки, герой врёт, будто люди наёмника уже схвачены и рассказали, где лежит украденное. Два тика он подсовывает беглецу ложные детали и ждёт поправок. Ветеран несколько раз невольно исправляет героя, а потом понимает, что сам выдал всё необходимое, и сдаётся живым."
next_stage_id = "alive_end"

[sub_resource type="Resource" id="Stage_str_combat"]
script = ExtResource("2_stage")
id = "str_combat"
stage_type = 3
duration_ticks = 1
mob_definition = ExtResource("4_bandit")
combat_victory_stage_id = "dead_end"
combat_start_hp_ratio = 1.0

[sub_resource type="Resource" id="Stage_dex_combat"]
script = ExtResource("2_stage")
id = "dex_combat"
stage_type = 3
duration_ticks = 1
mob_definition = ExtResource("4_bandit")
combat_victory_stage_id = "dead_end"
combat_start_hp_ratio = 0.7

[sub_resource type="Resource" id="Stage_wis_combat"]
script = ExtResource("2_stage")
id = "wis_combat"
stage_type = 3
duration_ticks = 1
mob_definition = ExtResource("4_bandit")
combat_victory_stage_id = "dead_end"
combat_start_hp_ratio = 0.85

[sub_resource type="Resource" id="Stage_alive_end"]
script = ExtResource("2_stage")
id = "alive_end"
stage_type = 4
duration_ticks = 1
diary_text = "Герой узнал в раненом путнике разыскиваемого ветерана банды и хитростью заставил его выдать себя окончательно. Беглеца удалось доставить живым, поэтому городские власти выплатили полную награду — сто золотых."
outcome_id = "fugitive_taken_alive"
gold_reward = 100

[sub_resource type="Resource" id="Stage_dead_end"]
script = ExtResource("2_stage")
id = "dead_end"
stage_type = 4
duration_ticks = 1
diary_text = "Раненый путник оказался разыскиваемым ветераном банды. Когда миром разойтись не получилось, герой победил его в бою и позже получил от городских властей шестьдесят золотых за подтверждённую смерть преступника."
outcome_id = "fugitive_defeated"
gold_reward = 60

[resource]
script = ExtResource("1_event")
id = "fugitive_mercenary"
display_name = "Беглый наёмник"
region_id = "starting_region"
placement_distance_hex_min = 4
placement_distance_hex_max = 6
placement_allowed_terrain_ids = PackedStringArray("hill")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_str_confront"), SubResource("Stage_dex_disarm"), SubResource("Stage_wis_question"), SubResource("Stage_str_devious_check"), SubResource("Stage_dex_devious_check"), SubResource("Stage_wis_devious_check"), SubResource("Stage_devious_confession"), SubResource("Stage_str_combat"), SubResource("Stage_dex_combat"), SubResource("Stage_wis_combat"), SubResource("Stage_alive_end"), SubResource("Stage_dead_end")])
