personality_delta = 5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "На равнине вдали от большой дороги герой замечает перевёрнутую почтовую повозку. Рядом лежит мёртвый городской гонец. Неподалёку находятся двое живых: тяжело раненый торговец и молодой наёмник. Оба говорят, что на них напала банда разбойников, но детали их рассказов не сходятся."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_WIS"), SubResource("Option_DEX"), SubResource("Option_CON")])

[sub_resource type="Resource" id="Stage_wis_investigation"]
script = ExtResource("2_stage")
id = "wis_investigation"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой два тика спокойно разбирает картину происшествия. Следов большой банды нет, кровь и положение тела показывают, что гонца убили уже после остановки повозки. Понимая, что убийца почти наверняка всё ещё рядом, герой всё равно остаётся и продолжает расследование."
next_stage_id = "wis_devious_check"

[sub_resource type="Resource" id="Stage_dex_investigation"]
script = ExtResource("2_stage")
id = "dex_investigation"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой два тика восстанавливает цепочку следов вокруг повозки. Он видит, что наёмник после смерти гонца возвращался к телу, а затем отходил к обочине. Там находится небольшой тайник с вещами преступника и одной добротной вещью, которую герой сможет забрать после развязки."
next_stage_id = "dex_devious_check"

[sub_resource type="Resource" id="Stage_con_investigation"]
script = ExtResource("2_stage")
id = "con_investigation"
stage_type = 0
decision_role = 0
duration_ticks = 4
scene_text = "Герой не бросает тяжело раненого торговца ради улик. Четыре тика уходят на остановку крови, перевязку и возвращение свидетеля в сознание. Торговец подтверждает, что наёмник ударил его, когда он попытался помешать тому обыскивать тело гонца."
next_stage_id = "con_devious_check"

[sub_resource type="Resource" id="Stage_wis_devious_check"]
script = ExtResource("2_stage")
id = "wis_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "wis_devious_interrogation"
trait_absent_stage_id = "wis_curious_check_direct"

[sub_resource type="Resource" id="Stage_dex_devious_check"]
script = ExtResource("2_stage")
id = "dex_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "dex_devious_interrogation"
trait_absent_stage_id = "dex_combat"

[sub_resource type="Resource" id="Stage_con_devious_check"]
script = ExtResource("2_stage")
id = "con_devious_check"
stage_type = 1
decision_role = 2
duration_ticks = 1
selection_rule = "trait_present"
checked_trait_id = "devious"
trait_present_stage_id = "con_devious_interrogation"
trait_absent_stage_id = "con_combat"

[sub_resource type="Resource" id="Stage_wis_devious_interrogation"]
script = ExtResource("2_stage")
id = "wis_devious_interrogation"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "Хитрый герой не выкладывает свои выводы сразу. Он врёт наёмнику, будто уже знает заказчика и судьбу пропавшего письма. Наёмник путается, выдаёт подробности, которых посторонний знать не мог, и понимает, что дальше отрицать бессмысленно."
next_stage_id = "wis_curious_check_devious"

[sub_resource type="Resource" id="Stage_dex_devious_interrogation"]
script = ExtResource("2_stage")
id = "dex_devious_interrogation"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "Герой блефует, будто уже нашёл спрятанное письмо вместе с тайником. Наёмник принимает ложь за правду, срывается и признаётся: его наняли перехватить письмо, гонца он убил, а торговца ранил как свидетеля."
next_stage_id = "dex_curious_check_devious"

[sub_resource type="Resource" id="Stage_con_devious_interrogation"]
script = ExtResource("2_stage")
id = "con_devious_interrogation"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "Герой преувеличивает показания спасённого торговца и уверяет наёмника, что тот уже рассказал всё до последней детали. Подозреваемый ломается и признаётся в убийстве гонца и попытке перехватить важное письмо."
next_stage_id = "con_curious_check_devious"

