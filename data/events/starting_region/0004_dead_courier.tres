[sub_resource type="Resource" id="Stage_wis_search_direct"]
script = ExtResource("2_stage")
id = "wis_search_direct"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Раскрыть убийство любопытному герою недостаточно. Ещё два тика он обыскивает место происшествия и находит спрятанное письмо, из-за которого погиб гонец."
next_stage_id = "wis_end_direct_curious"

[sub_resource type="Resource" id="Stage_wis_search_devious"]
script = ExtResource("2_stage")
id = "wis_search_devious"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "После признания любопытство не позволяет герою закончить дело. Ещё два тика он ищет спрятанное письмо и находит его неподалёку от повозки."
next_stage_id = "wis_end_devious_curious"

[sub_resource type="Resource" id="Stage_dex_search_fight"]
script = ExtResource("2_stage")
id = "dex_search_fight"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "После схватки герой продолжает расследование. Любопытство заставляет его ещё два тика искать главный предмет преступления, и рядом с тайником обнаруживается спрятанное письмо."
next_stage_id = "dex_end_fight_curious"

[sub_resource type="Resource" id="Stage_dex_search_devious"]
script = ExtResource("2_stage")
id = "dex_search_devious"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Получив признание, герой всё равно не останавливается. Ещё два тика он проверяет окрестности найденного тайника и обнаруживает спрятанное письмо."
next_stage_id = "dex_end_devious_curious"

[sub_resource type="Resource" id="Stage_con_search_fight"]
script = ExtResource("2_stage")
id = "con_search_fight"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Наёмник побеждён, но любопытный герой хочет понять причину убийства до конца. Ещё два тика поиска приводят его к спрятанному письму."
next_stage_id = "con_end_fight_curious"

[sub_resource type="Resource" id="Stage_con_search_devious"]
script = ExtResource("2_stage")
id = "con_search_devious"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "После признания преступника герой ещё два тика ищет то, ради чего погиб гонец, и находит спрятанное письмо."
next_stage_id = "con_end_devious_curious"

[sub_resource type="Resource" id="Stage_wis_end_direct"]
script = ExtResource("2_stage")
id = "wis_end_direct"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "На равнине герой нашёл убитого гонца и понял, что рассказ о нападении банды был ложью. Он остался рядом с вероятным убийцей, разобрал противоречия и безопасно добился развязки без боя. За раскрытое убийство городские власти выплатили семьдесят пять золотых."
outcome_id = "wis_case_solved"
gold_reward = 75

[sub_resource type="Resource" id="Stage_wis_end_direct_curious"]
script = ExtResource("2_stage")
id = "wis_end_direct_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой раскрыл убийство гонца без боя, а затем из любопытства продолжил поиски и нашёл пропавшее письмо. За раскрытое преступление и возвращённую корреспонденцию город выплатил сто двадцать пять золотых."
outcome_id = "wis_case_solved_letter"
gold_reward = 125

[sub_resource type="Resource" id="Stage_wis_end_devious"]
script = ExtResource("2_stage")
id = "wis_end_devious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Разобрав картину убийства гонца, герой хитростью заставил наёмника выдать себя и признаться. Дело закончилось без боя, а городские власти выплатили семьдесят пять золотых."
outcome_id = "wis_confession"
gold_reward = 75

[sub_resource type="Resource" id="Stage_wis_end_devious_curious"]
script = ExtResource("2_stage")
id = "wis_end_devious_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой раскрыл убийство гонца, хитростью добился признания наёмника и затем нашёл спрятанное письмо. За убийцу и возвращённую корреспонденцию город выплатил сто двадцать пять золотых."
outcome_id = "wis_confession_letter"
gold_reward = 125

[sub_resource type="Resource" id="Stage_dex_end_fight"]
script = ExtResource("2_stage")
id = "dex_end_fight"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Следы у мёртвого гонца вывели героя к тайнику наёмника и доказали, что тот обыскивал тело. Преступник попытался прорваться силой и был побеждён. За раскрытое убийство герой получил семьдесят пять золотых и забрал найденную в тайнике добротную вещь."
outcome_id = "dex_fight_case_solved"
gold_reward = 75
equipment_reward_source = ExtResource("5_ilvl5_source")
equipment_rarity_override = 0

[sub_resource type="Resource" id="Stage_dex_end_fight_curious"]
script = ExtResource("2_stage")
id = "dex_end_fight_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Проследив путь наёмника, герой нашёл его тайник, затем победил преступника в бою и продолжил поиски до обнаружения пропавшего письма. Город выплатил сто двадцать пять золотых, а найденная в тайнике добротная вещь осталась у героя."
outcome_id = "dex_fight_case_solved_letter"
gold_reward = 125
equipment_reward_source = ExtResource("5_ilvl5_source")
equipment_rarity_override = 0

[sub_resource type="Resource" id="Stage_dex_end_devious"]
script = ExtResource("2_stage")
id = "dex_end_devious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Следы привели героя к тайнику наёмника. Хитрым блефом герой заставил преступника признаться и избежал драки. За раскрытое убийство он получил семьдесят пять золотых и забрал добротную вещь из тайника."
outcome_id = "dex_confession"
gold_reward = 75
equipment_reward_source = ExtResource("5_ilvl5_source")
equipment_rarity_override = 0

[sub_resource type="Resource" id="Stage_dex_end_devious_curious"]
script = ExtResource("2_stage")
id = "dex_end_devious_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой по следам нашёл тайник наёмника, блефом добился признания, а затем из любопытства отыскал и пропавшее письмо. Город выплатил сто двадцать пять золотых, а добротная вещь из тайника осталась у героя."
outcome_id = "dex_confession_letter"
gold_reward = 125
equipment_reward_source = ExtResource("5_ilvl5_source")
equipment_rarity_override = 0

[sub_resource type="Resource" id="Stage_con_end_fight"]
script = ExtResource("2_stage")
id = "con_end_fight"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой прежде всего спас тяжело раненого торговца, и его показания разоблачили наёмника. Преступник попытался прорваться и был побеждён. Город выплатил семьдесят пять золотых, а спасённый торговец добавил ещё двадцать пять в благодарность."
outcome_id = "con_fight_witness_saved"
gold_reward = 100

[sub_resource type="Resource" id="Stage_con_end_fight_curious"]
script = ExtResource("2_stage")
id = "con_end_fight_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Спасённый торговец помог герою разоблачить убийцу гонца. После победы над наёмником герой нашёл пропавшее письмо. Город и благодарный торговец вместе выплатили сто пятьдесят золотых."
outcome_id = "con_fight_witness_saved_letter"
gold_reward = 150

[sub_resource type="Resource" id="Stage_con_end_devious"]
script = ExtResource("2_stage")
id = "con_end_devious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой спас тяжело раненого торговца, а затем использовал его показания и хитрый блеф, чтобы заставить наёмника признаться без боя. Город выплатил семьдесят пять золотых, торговец добавил ещё двадцать пять."
outcome_id = "con_confession_witness_saved"
gold_reward = 100

[sub_resource type="Resource" id="Stage_con_end_devious_curious"]
script = ExtResource("2_stage")
id = "con_end_devious_curious"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой спас торговца, хитростью добился признания убийцы и затем нашёл пропавшее письмо. За раскрытое дело, возвращённую корреспонденцию и спасённую жизнь он получил в общей сложности сто пятьдесят золотых."
outcome_id = "con_confession_witness_saved_letter"
gold_reward = 150

