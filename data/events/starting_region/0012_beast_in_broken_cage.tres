[sub_resource type="Resource" id="Stage_reward_end"]
script = ExtResource("2_stage")
id = "reward_end"
stage_type = 4
duration_ticks = 1
diary_text = "У разбитой клетки звероловов герой справился с разъярённым медведем, предварительно ранив его с помощью обломков повозки и клетки. Среди вещей погибших охотников нашлась зелёная экипировка пятого уровня."
outcome_id = "escaped_bear_defeated"
equipment_reward_source = ExtResource("5_ilvl5")
equipment_rarity_override = 1

[resource]
script = ExtResource("1_event")
id = "beast_in_broken_cage"
display_name = "Зверь в сломанной клетке"
region_id = "starting_region"
placement_distance_hex_min = 4
placement_distance_hex_max = 6
placement_allowed_terrain_ids = PackedStringArray("forest")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_str_prepare"), SubResource("Stage_con_prepare"), SubResource("Stage_wis_prepare"), SubResource("Stage_str_cautious_check"), SubResource("Stage_con_cautious_check"), SubResource("Stage_wis_cautious_check"), SubResource("Stage_str_extra_prepare"), SubResource("Stage_con_extra_prepare"), SubResource("Stage_wis_extra_prepare"), SubResource("Stage_str_combat"), SubResource("Stage_con_combat"), SubResource("Stage_wis_combat"), SubResource("Stage_str_extra_combat"), SubResource("Stage_con_extra_combat"), SubResource("Stage_wis_extra_combat"), SubResource("Stage_reward_end")])
