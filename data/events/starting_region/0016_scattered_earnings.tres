[gd_resource type="Resource" script_class="EventDefinition" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/event_definition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_stage_definition.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_option_definition.gd" id="3_option"]

[sub_resource type="Resource" id="Option_STR"]
script = ExtResource("3_option")
id = "claim_large_finders_fee"
driver_attribute = "strength"
next_stage_id = "str_guard"
personality_axis_id = "greed"
personality_delta = -5

[sub_resource type="Resource" id="Option_DEX"]
script = ExtResource("3_option")
id = "hide_one_pouch"
driver_attribute = "dexterity"
next_stage_id = "dex_sort"
personality_axis_id = "morality"
personality_delta = -5

[sub_resource type="Resource" id="Option_CON"]
script = ExtResource("3_option")
id = "seal_everything_first"
driver_attribute = "constitution"
next_stage_id = "con_count"
personality_axis_id = "curiosity"
personality_delta = -5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
duration_ticks = 1
scene_text = "На дороге герой встречает торгового приказчика возле опрокинутой ручной тележки. Крышка денежного ящика сорвана, несколько мешочков с выручкой рассыпались по грязи, а сам приказчик в панике пытается одновременно собрать монеты и отогнать любопытных прохожих."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_STR"), SubResource("Option_DEX"), SubResource("Option_CON")])

[sub_resource type="Resource" id="Stage_str_guard"]
script = ExtResource("2_stage")
id = "str_guard"
stage_type = 0
duration_ticks = 2
scene_text = "Герой быстро оттаскивает тяжёлый ящик с проезжей части и два тика держит зевак подальше, пока приказчик собирает остальное. Когда всё оказывается на месте, герой прямо заявляет, что за спасённую выручку рассчитывает на крупную долю, а не на символическую благодарность."
next_stage_id = "str_end"

[sub_resource type="Resource" id="Stage_dex_sort"]
script = ExtResource("2_stage")
id = "dex_sort"
stage_type = 0
duration_ticks = 2
scene_text = "Герой ловко собирает рассыпанные мешочки раньше остальных. Один маленький кошель он незаметно прячет под плащ, а приказчику возвращает ящик и основную выручку так уверенно, будто ничего другого в грязи и не лежало."
next_stage_id = "dex_end"

[sub_resource type="Resource" id="Stage_con_count"]
script = ExtResource("2_stage")
id = "con_count"
stage_type = 0
duration_ticks = 3
scene_text = "Герой не торопится поднимать всё подряд. Три тика он отделяет мокрые монеты от сухих, пересчитывает мешочки вместе с приказчиком и заново перевязывает ящик, чтобы по дороге ничего больше не потерялось. За работу он принимает только заранее названную плату."
next_stage_id = "con_end"

[sub_resource type="Resource" id="Stage_str_end"]
script = ExtResource("2_stage")
id = "str_end"
stage_type = 4
duration_ticks = 1
diary_text = "Герой помог торговому приказчику собрать рассыпавшуюся выручку, но потребовал за спасённые деньги крупную долю. Приказчик нехотя отдал ему девяносто золотых."
outcome_id = "earnings_returned_for_large_fee"
gold_reward = 90

[sub_resource type="Resource" id="Stage_dex_end"]
script = ExtResource("2_stage")
id = "dex_end"
stage_type = 4
duration_ticks = 1
diary_text = "Помогая собрать рассыпавшуюся выручку, герой незаметно оставил один из маленьких кошелей себе. Приказчик получил основной ящик обратно, а у героя осталось восемьдесят золотых."
outcome_id = "earnings_partly_hidden"
gold_reward = 80

[sub_resource type="Resource" id="Stage_con_end"]
script = ExtResource("2_stage")
id = "con_end"
stage_type = 4
duration_ticks = 1
diary_text = "Герой тщательно пересчитал и заново упаковал рассыпавшуюся выручку торгового приказчика. Не рискуя ни чужими деньгами, ни собственной репутацией, он взял оговорённые сорок пять золотых и продолжил путь."
outcome_id = "earnings_safely_repacked"
gold_reward = 45

[resource]
script = ExtResource("1_event")
id = "scattered_earnings"
display_name = "Рассыпавшаяся выручка"
region_id = "starting_region"
placement_distance_hex_min = 2
placement_distance_hex_max = 4
placement_allowed_tags = PackedStringArray("road")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_str_guard"), SubResource("Stage_dex_sort"), SubResource("Stage_con_count"), SubResource("Stage_str_end"), SubResource("Stage_dex_end"), SubResource("Stage_con_end")])
