[gd_resource type="Resource" script_class="EventDefinition" load_steps=27 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/event_definition.gd" id="1_event"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_stage_definition.gd" id="2_stage"]
[ext_resource type="Script" path="res://scripts/model/definitions/event_option_definition.gd" id="3_option"]
[ext_resource type="Resource" path="res://data/mobs/mid_region/0106_warg_pack_leader.tres" id="4_warg"]

[sub_resource type="Resource" id="Option_STR"]
script = ExtResource("3_option")
id = "pull_the_guard_out"
driver_attribute = "strength"
next_stage_id = "str_prepare"
personality_axis_id = "courage"
personality_delta = 5

[sub_resource type="Resource" id="Option_DEX"]
script = ExtResource("3_option")
id = "use_the_cargo_as_bait"
driver_attribute = "dexterity"
next_stage_id = "dex_prepare"
personality_axis_id = "morality"
personality_delta = -5

[sub_resource type="Resource" id="Option_CON"]
script = ExtResource("3_option")
id = "hold_the_wagon_circle"
driver_attribute = "constitution"
next_stage_id = "con_prepare"
personality_axis_id = "curiosity"
personality_delta = -5

[sub_resource type="Resource" id="Stage_intro"]
script = ExtResource("2_stage")
id = "intro"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "На открытой равнине герой находит разбитый обоз снабжения Ардена. Две телеги поставлены боком, несколько возчиков укрылись между ними, а один раненый страж лежит у перевёрнутой повозки. Обычных варгов охрана уже отогнала, но крупный вожак продолжает кружить рядом и не даёт людям ни забрать раненого, ни собрать рассыпанные припасы."
next_stage_id = "first_decision"

[sub_resource type="Resource" id="Stage_first_decision"]
script = ExtResource("2_stage")
id = "first_decision"
stage_type = 1
decision_role = 1
duration_ticks = 1
selection_rule = "highest_primary_attribute"
options = Array[Resource]([SubResource("Option_STR"), SubResource("Option_DEX"), SubResource("Option_CON")])

[sub_resource type="Resource" id="Stage_str_prepare"]
script = ExtResource("2_stage")
id = "str_prepare"
stage_type = 0
decision_role = 0
duration_ticks = 1
scene_text = "Герой не ждёт, пока зверь снова отойдёт. Он выбегает из-за телег, поднимает раненого стража и силой тащит его обратно к обозу. Вожак сразу бросается следом, и герой разворачивается навстречу, принимая бой почти без подготовки."
next_stage_id = "str_combat"

[sub_resource type="Resource" id="Stage_dex_prepare"]
script = ExtResource("2_stage")
id = "dex_prepare"
stage_type = 0
decision_role = 0
duration_ticks = 2
scene_text = "Герой замечает мешки с вяленым мясом для гарнизона. Не спрашивая возчиков, он два тика режет один мешок и тянет по траве длинный след приманки к низине. Когда вожак идёт по запаху, герой обрушивается на него из укрытия. Потерю мяса потом легко списать на нападение варгов."
next_stage_id = "dex_combat"

[sub_resource type="Resource" id="Stage_con_prepare"]
script = ExtResource("2_stage")
id = "con_prepare"
stage_type = 0
decision_role = 0
duration_ticks = 3
scene_text = "Герой не преследует зверя по открытой траве. Три тика он укрепляет промежутки между телегами, переносит раненого внутрь круга и заставляет людей держаться за укрытием. Вожак сам идёт на привычную добычу и оказывается в узком проходе между колёсами."
next_stage_id = "con_combat"

[sub_resource type="Resource" id="Stage_str_combat"]
script = ExtResource("2_stage")
id = "str_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_warg")
combat_victory_stage_id = "str_end"
combat_start_hp_ratio = 1.0

[sub_resource type="Resource" id="Stage_dex_combat"]
script = ExtResource("2_stage")
id = "dex_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_warg")
combat_victory_stage_id = "dex_end"
combat_start_hp_ratio = 0.7

[sub_resource type="Resource" id="Stage_con_combat"]
script = ExtResource("2_stage")
id = "con_combat"
stage_type = 3
decision_role = 0
duration_ticks = 1
mob_definition = ExtResource("4_warg")
combat_victory_stage_id = "con_end"
combat_start_hp_ratio = 0.85

[sub_resource type="Resource" id="Stage_str_end"]
script = ExtResource("2_stage")
id = "str_end"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "На равнине герой вытащил раненого стража из-под самого носа вожака варгов и победил зверя в прямой схватке. Обоз смог продолжить путь, а старший возчиков отдал герою двести сорок золотых."
outcome_id = "supply_wagon_saved_boldly"
gold_reward = 240

[sub_resource type="Resource" id="Stage_dex_end"]
script = ExtResource("2_stage")
id = "dex_end"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой пожертвовал частью гарнизонного мяса без разрешения возчиков, заманил вожака варгов в низину и тяжело ранил его ещё до схватки. После победы он промолчал о своей уловке и получил двести восемьдесят золотых за спасённый обоз."
outcome_id = "supply_wagon_saved_by_deception"
gold_reward = 280

[sub_resource type="Resource" id="Stage_con_end"]
script = ExtResource("2_stage")
id = "con_end"
stage_type = 4
decision_role = 0
duration_ticks = 1
diary_text = "Герой отказался гоняться за варгом по равнине, укрепил телеги и дождался зверя на подготовленной позиции. После победы люди собрали припасы и заплатили ему двести шестьдесят золотых."
outcome_id = "supply_wagon_saved_from_defense"
gold_reward = 260

[resource]
script = ExtResource("1_event")
id = "wargs_at_supply_wagon"
display_name = "Варги у обоза снабжения"
region_id = "mid_region"
placement_distance_hex_min = 3
placement_distance_hex_max = 5
placement_allowed_terrain_ids = PackedStringArray("plains")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 1
activation_radius = 1
lifetime_ticks = 200
start_stage_id = "intro"
stages = Array[Resource]([SubResource("Stage_intro"), SubResource("Stage_first_decision"), SubResource("Stage_str_prepare"), SubResource("Stage_dex_prepare"), SubResource("Stage_con_prepare"), SubResource("Stage_str_combat"), SubResource("Stage_dex_combat"), SubResource("Stage_con_combat"), SubResource("Stage_str_end"), SubResource("Stage_dex_end"), SubResource("Stage_con_end")])
