[gd_resource type="Resource" script_class="DungeonDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/model/definitions/dungeon_definition.gd" id="1_dungeon_definition"]
[ext_resource type="Resource" path="res://data/dungeons/mid_region/0001_border_deserter.tres" id="2_ordinary_mob"]
[ext_resource type="Resource" path="res://data/dungeons/mid_region/0001_deserter_captain.tres" id="3_boss_mob"]
[ext_resource type="Resource" path="res://data/loot/azure_dawnplate_ilvl15_drop_table.tres" id="4_completion_equipment"]

[resource]
script = ExtResource("1_dungeon_definition")
id = "abandoned_border_fort"
display_name = "Заброшенный пограничный форт"
region_id = "mid_region"
placement_distance_hex_min = 4
placement_distance_hex_max = 6
placement_allowed_terrain_ids = PackedStringArray("plains")
placement_forbidden_tags = PackedStringArray("city")
placement_radius = 0
ordinary_mob_definition = ExtResource("2_ordinary_mob")
ordinary_encounter_count = 3
boss_mob_definition = ExtResource("3_boss_mob")
completion_gold_reward = 3000
completion_equipment_source = ExtResource("4_completion_equipment")
completion_epic_chance = 0.25
